# ---- Server ----
NODE_ENV=development
PORT=8080

# ---- Database ----
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codearena

# ---- JWT ----
JWT_SECRET=codearena-super-secure-jwt-dev-secret-key-2026
JWT_ACCESS_EXPIRY_MS=3600000
JWT_REFRESH_EXPIRY_MS=604800000

# ---- Admin Security ----
# Secret passphrase required to register new ADMIN accounts on /register
ADMIN_SECRET_CODE=codearena-admin-2026

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Email (Resend API) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=CodeArena <onboarding@resend.dev>

# ---- Judge (Docker sandbox) ----
# NOTE: the judge shells out to the `docker` CLI. This ONLY works on a host
# with the Docker daemon available (a VM, Render, Railway, Fly.io, your own
# server, etc). It will NOT work on Vercel serverless functions — see
# README.md "Deploying to Vercel" for how to split this out.
JUDGE_WORKDIR=/tmp/codearena-submissions
JUDGE_TIMEOUT_SECONDS=10
JUDGE_MEMORY_MB=256
JUDGE_CPU_LIMIT=1
JUDGE_PIDS_LIMIT=64

# Set to "true" to disable the Docker judge (e.g. on Vercel or local without Docker)
# and have /run and /submit return a clear 503 instead of trying to shell out.
JUDGE_DISABLED=true
