# ---- Server ----
NODE_ENV=development
PORT=8080

# ---- Database ----
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codearena

# ---- JWT ----
JWT_SECRET=change-this-dev-secret-change-this-dev-secret-please
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# ---- CORS ----
# Comma-separated list of allowed origins (matches Spring's CorsProperties)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Email (Resend API) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=CodeArena <onboarding@resend.dev>

# ---- Judge (Docker sandbox) ----
# NOTE: the judge shells out to the `docker` CLI. This ONLY works on a host
# with the Docker daemon available (a VM, Render, Railway, Fly.io, your own
# server, etc). It will NOT work on Vercel serverless functions — see
# README.md "Deploying to Vercel" for how to split this out.
JUDGE_WORKDIR=/tmp/codearena-submissions
JUDGE_TIMEOUT_SECONDS=10
JUDGE_MEMORY_MB=256
JUDGE_CPU_LIMIT=1
JUDGE_PIDS_LIMIT=64

# Set to "true" to disable the Docker judge entirely (e.g. on Vercel) and
# have /run and /submit return a clear 503 instead of trying to shell out.
JUDGE_DISABLED=false
